apptainer exec --nv --env PYTHONNOUSERSITE=1 --env TORCH_CUDA_ARCH_LIST=9.0 --env TORCH_EXTENSIONS_DIR=/data/almog/Projects/QBench-Release/runspace/.torch_extensions --env TORCH_HOME=/home/almog/.cache/torch --env PYTHONPATH=/data/almog/Projects/QBench-Release:/data/almog/Projects/QBench-Release/runspace/.pylibs --env HF_HOME=/data/almog/Projects/QBench-Release/.cache/huggingface --env UCX_HANDLE_ERRORS=none --env RDMAV_FORK_SAFE=1 --env IBV_FORK_SAFE=1 --bind /data/shared_data/imagenet:/data/imagenet --bind /data/almog/Projects/QBench-Release:/app --bind /data/shared_data/scannet:/data/scannet "qbench_sandbox" python -c "exec(\"\\nimport gc\\nimport statistics\\nimport time\\nimport torch\\n\\nfrom runspace.src.quantization.activation_transport import (\\n    _activation_chunks,\\n    _validate_packet,\\n    decode_activation_packet,\\n    encode_dynamic_packet,\\n    encode_uniform_packet,\\n)\\nfrom runspace.src.quantization.cuda import encode_chunk, decode_chunk\\n\\nassert torch.cuda.is_available()\\ntorch.manual_seed(123)\\ndevice = torch.device('cuda')\\nprint('DEVICE', torch.cuda.get_device_name(0))\\nprint('TORCH', torch.__version__)\\n\\nSHAPES = [\\n    ('resnet_early', (1, 64, 56, 56)),\\n    ('resnet_late', (1, 2048, 7, 7)),\\n    ('vit_tokens', (1, 197, 768)),\\n    ('vit_attention', (1, 12, 197, 197)),\\n]\\nFMT2 = ('fp4_e2m1', 'fp8_e4m3')\\nFMT4 = ('fp2_e1m0', 'fp4_e2m1', 'fp6_e2m3', 'fp8_e4m3')\\nWARMUP = 8\\nSERIAL_ITERS = 25\\nBATCH_ITERS = 40\\n\\ndef warm(fn):\\n    out = None\\n    for _ in range(WARMUP):\\n        out = fn()\\n    torch.cuda.synchronize()\\n    return out\\n\\ndef serial_us(fn):\\n    values = []\\n    out = warm(fn)\\n    for _ in range(SERIAL_ITERS):\\n        torch.cuda.synchronize()\\n        start = time.perf_counter_ns()\\n        out = fn()\\n        torch.cuda.synchronize()\\n        values.append((time.perf_counter_ns() - start) / 1000.0)\\n    values.sort()\\n    return statistics.median(values), values[int(0.9 * (len(values) - 1))], out\\n\\ndef batched_us(fn):\\n    out = warm(fn)\\n    samples = []\\n    for _ in range(3):\\n        torch.cuda.synchronize()\\n        start = time.perf_counter_ns()\\n        for _ in range(BATCH_ITERS):\\n            out = fn()\\n        torch.cuda.synchronize()\\n        samples.append((time.perf_counter_ns() - start) / 1000.0 / BATCH_ITERS)\\n    return statistics.median(samples), out\\n\\ndef measure(label, fn):\\n    med, p90, out = serial_us(fn)\\n    batch, out = batched_us(fn)\\n    print(f'METRIC {label:24s} serial_median_us={med:10.3f} serial_p90_us={p90:10.3f} batched_us={batch:10.3f}')\\n    return out\\n\\nfor shape_name, shape in SHAPES:\\n    gc.collect()\\n    torch.cuda.empty_cache()\\n    x = torch.randn(shape, device=device, dtype=torch.float32)\\n    chunks, _, _, _ = _activation_chunks(x, 128)\\n    torch.cuda.synchronize()\\n    n_chunks = chunks.shape[0]\\n    ids2 = (torch.arange(n_chunks, device=device, dtype=torch.int32) % 2).contiguous()\\n    ids4 = (torch.arange(n_chunks, device=device, dtype=torch.int32) % 4).contiguous()\\n    raw_data, raw_scales = encode_chunk(chunks, 4, 3, True)\\n    uniform_packet = encode_uniform_packet(x, 'fp8_e4m3')\\n    mixed2_packet = encode_dynamic_packet(x, ids2, FMT2)\\n    mixed4_packet = encode_dynamic_packet(x, ids4, FMT4)\\n    torch.cuda.synchronize()\\n    print(f'\\\\nSHAPE {shape_name} {shape} elements={x.numel()} chunks={n_chunks}')\\n    measure('chunk_layout', lambda: _activation_chunks(x, 128))\\n    measure('raw_encode_fp8', lambda: encode_chunk(chunks, 4, 3, True))\\n    measure('raw_decode_fp8', lambda: decode_chunk(raw_data, raw_scales, [n_chunks, 128], 4, 3, True))\\n    measure('validate_uniform', lambda: _validate_packet(uniform_packet))\\n    measure('uniform_encode', lambda: encode_uniform_packet(x, 'fp8_e4m3'))\\n    measure('uniform_decode', lambda: decode_activation_packet(uniform_packet))\\n    measure('mixed2_encode', lambda: encode_dynamic_packet(x, ids2, FMT2))\\n    measure('mixed2_decode', lambda: decode_activation_packet(mixed2_packet))\\n    measure('mixed4_encode', lambda: encode_dynamic_packet(x, ids4, FMT4))\\n    measure('mixed4_decode', lambda: decode_activation_packet(mixed4_packet))\\n    print(f'BYTES uniform={uniform_packet.encoded_nbytes} mixed2={mixed2_packet.encoded_nbytes} mixed4={mixed4_packet.encoded_nbytes}')\\n\")"
