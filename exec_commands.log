e2=(vals-q2).pow(2)
d=e2-e1
scale=2**(2*m1)
print('vals',vals)
print('q1',q1)
print('q2',q2)
print('e1*scale',e1*scale)
print('e2*scale',e2*scale)
print('diff*scale',d*scale)
