import torch
from runspace.experiments.pseudo_mse2.generate_hw_vectors import make_raw_chunks, scale_raw_chunks, pseudo_mse_reconstruct_scaled_export, BIT_WIDTHS
from runspace.src.quantization.dynamic_input_metrics import pseudo_mse2_err2_minus_err1_from_scaled, pseudo_mse_weighted_win_counts_from_diff, reduce_dynamic_input_metric_python
raw = make_raw_chunks(num_chunks=100, seed=42)
_, scaled = scale_raw_chunks(raw)
print("pseudo_mse2 vs mse mismatched chunks by decision divisor")
for d in [1,2,3,4,5,6]:
    total = 0
    parts = []
    for bit_width in BIT_WIDTHS:
        m1 = bit_width - 2
        m2 = bit_width - 3
        q1 = pseudo_mse_reconstruct_scaled_export(scaled, 1, m1, True)
        q2 = pseudo_mse_reconstruct_scaled_export(scaled, 2, m2, True)
        err1_pre = scaled - q1
        err2_pre = scaled - q2
        diff = pseudo_mse2_err2_minus_err1_from_scaled(scaled, m1, m2, True)
        e1, e2 = pseudo_mse_weighted_win_counts_from_diff(diff)
        choose_exp2 = torch.div(e2, d, rounding_mode="floor") >= e1
        mse1 = reduce_dynamic_input_metric_python("mse", err1_pre, 0.0625)
        mse2 = reduce_dynamic_input_metric_python("mse", err2_pre, 0.0625)
        metric_choose_exp2 = mse2 <= mse1
        bad = (choose_exp2 != metric_choose_exp2) & ((mse1 - mse2).abs() > 0)
        count = int(bad.sum().item())
        parts.append(f"b{bit_width}={count}")
        total += count
    print(f"divisor={d}: total={total}/500 " + " ".join(parts))

