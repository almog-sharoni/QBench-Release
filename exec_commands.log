import torch
from runspace.src.quantization.dynamic_input_metrics import pseudo_mse_reconstruct_scaled_python
m1=6
vals=torch.tensor([
1.0+2**-m1+2**-(m1+1)+2**-(m1+2),
1.5*2**-1,
(1.0+2**-5+2**-6+2**-7)*2**-2,
(1.0+2**-1+2**-2)*2**-(m1+1),
2**-(m1+2),
],dtype=torch.float32)
q1=pseudo_mse_reconstruct_scaled_python(vals,1,m1,True)
