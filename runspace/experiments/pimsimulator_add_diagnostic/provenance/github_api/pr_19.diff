+                return false;
+        }
+        return true;
+    }
+    else if(queuingStructure_== PerRankPerBankPerSubarray)
+    {
+        for(size_t i = 0; i < num_banks_; i++)
+        {
+            for(size_t j = 0; j < num_subarrays_; j++)
+            {
+                if(!queues_sub[rank][i][j].empty())
+                    return false;
+            }
+        }
+        return true;
+    }
+    else
+    {
+        DEBUG("Invalid Queueing Structure");
+        abort();
+    }
