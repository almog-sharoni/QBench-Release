+void PIMBlock::reducesum(BurstType& dstBst)
+{
+    if(pimPrecision_ == FP16)
+    {
+        for (int i = 0; i<16; i++)
+        {
+            dstBst.fp16Data_[0] += dstBst.fp16Data_[i];
+        }
+    }
+    if(pimPrecision_ == FP32)
+    {
+        for (int i = 0; i<8; i++)
+        {
+            dstBst.fp32Data_[0] += dstBst.fp32Data_[i];
+        }
+    }
+}
