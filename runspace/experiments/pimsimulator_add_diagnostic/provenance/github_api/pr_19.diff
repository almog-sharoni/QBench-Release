+void CommandQueue::nextRankAndBankandSubarray(unsigned& rank, unsigned& bank, unsigned& sub)
+{
+    if (schedulingPolicy_ == RankThenBankThenSubarrayRoundRobin)
+    {
+        sub++;
+        if(sub == 4)
+        {
+            sub = 0;
+            bank++;
+            if(bank == num_banks_)
+            {
+                bank = 0;
+                rank++;
+                if(rank == num_ranks_)
+                {
+                    rank = 0;
+                }
+            }
+        }
+    }
+}
